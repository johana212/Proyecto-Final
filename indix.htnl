<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Johana Laica | Perfil</title>
  <style>
    :root {
      --bg: #f4f7ff;
      --panel: rgba(255, 255, 255, 0.86);
      --text: #203454;
      --muted: #5d7193;
      --primary: #456dd7;
      --primary-2: #6a87ff;
      --border: #d9e4ff;
      --shadow: 0 16px 40px rgba(49, 80, 157, 0.14);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, #dce8ff 0%, transparent 30%),
        radial-gradient(circle at bottom right, #e9ecff 0%, transparent 32%),
        linear-gradient(135deg, #f8fbff, #eef3ff 60%, #f6f9ff);
    }

    .topbar {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(14px);
      position: sticky;
      top: 0;
      z-index: 20;
      box-shadow: 0 8px 24px rgba(54, 85, 158, 0.08);
      border-bottom: 1px solid rgba(198, 214, 255, 0.6);
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 1.05rem;
      font-weight: 800;
      color: #24406c;
    }

    .logo {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), var(--primary-2));
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 700;
      box-shadow: 0 10px 22px rgba(70, 100, 195, 0.35);
    }

    .nav-links {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .nav-links a {
      text-decoration: none;
      color: #36507d;
      font-weight: 700;
      padding: 10px 14px;
      border-radius: 12px;
      transition: 0.25s ease;
    }

    .nav-links a:hover {
      background: #eef4ff;
      color: var(--primary);
      transform: translateY(-1px);
    }

    .layout {
      max-width: 1240px;
      margin: 30px auto;
      padding: 0 20px 28px;
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 30px;
    }

    .sidebar,
    .content {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: var(--shadow);
    }

    .sidebar {
      padding: 24px;
      height: fit-content;
      position: relative;
      overflow: hidden;
    }

    .sidebar::before {
      content: "";
      position: absolute;
      top: -40px;
      right: -40px;
      width: 140px;
      height: 140px;
      border-radius: 50%;
      background: rgba(101, 133, 255, 0.14);
    }

    .profile-box {
      position: relative;
      z-index: 1;
    }

    .profile-photo {
      width: 170px;
      height: 170px;
      object-fit: cover;
      border-radius: 50%;
      display: block;
      margin: 0 auto 18px;
      border: 5px solid #dce8ff;
      box-shadow: 0 12px 30px rgba(58, 87, 158, 0.25);
    }

    .profile-name {
      text-align: center;
      font-weight: 800;
      font-size: 1.25rem;
      margin-bottom: 6px;
    }

    .profile-role {
      text-align: center;
      color: var(--muted);
      font-size: 0.95rem;
      margin-bottom: 22px;
    }

    .units-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 12px;
    }

    .units-list li {
      background: linear-gradient(135deg, #f4f8ff, #edf3ff);
      border: 1px solid #dce7ff;
      border-radius: 14px;
      padding: 14px 16px;
      font-weight: 700;
      color: #36507f;
      transition: 0.25s ease;
    }

    .units-list li:hover {
      transform: translateX(4px);
      background: linear-gradient(135deg, #e8f0ff, #dbe7ff);
    }

    .content {
      padding: 34px;
    }

    .hero {
      text-align: center;
      margin-bottom: 26px;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.35rem);
      color: #203a67;
    }

    .hero p {
      margin: 12px auto 0;
      max-width: 700px;
      color: var(--muted);
      font-size: 1rem;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 22px;
    }

    .info-card {
      background: linear-gradient(180deg, #f9fbff, #edf3ff);
      border: 1px solid #dbe7ff;
      border-radius: 16px;
      padding: 16px;
      text-align: center;
      transition: 0.25s ease;
    }

    .info-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(69, 109, 215, 0.12);
    }

    .info-card .label {
      display: block;
      color: #6a7fa8;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 8px;
    }

    .info-card .value {
      font-weight: 800;
      color: #24406b;
    }

    .bibliography {
      background: linear-gradient(180deg, #f8fbff, #eef4ff);
      border: 1px solid #d7e4ff;
      border-radius: 20px;
      padding: 24px;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }

    .bibliography-title {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 999px;
      background: #e9f0ff;
      color: #34538f;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .bibliography p {
      margin: 0;
      font-size: 1.05rem;
      line-height: 1.9;
      color: #334a74;
    }

    @media (max-width: 960px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .info-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 680px) {
      .topbar {
        flex-direction: column;
        gap: 14px;
      }

      .info-grid {
        grid-template-columns: 1fr;
      }

      .content {
        padding: 22px;
      }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <div class="logo">JL</div>
      <span>Johana Laica</span>
    </div>

    <nav class="nav-links">
      <a href="#">Inicio</a>
      <a href="#">Unidad 1</a>
      <a href="#">Unidad 2</a>
      <a href="#">Unidad 3</a>
    </nav>
  </header>

  <main class="layout">
    <aside class="sidebar">
      <div class="profile-box">
        <img
          class="profile-photo"
          src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=500&q=80"
          alt="Foto de perfil de Johana"
        />

        <div class="profile-name">Johana Laica</div>
        <div class="profile-role">Estudiante de Ingeniería en Software</div>

        <ul class="units-list">
          <li>Unidad 1</li>
          <li>Unidad 2</li>
          <li>Unidad 3</li>
        </ul>
      </div>
    </aside>

    <section class="content">
      <div class="hero">
        <h1>Johana Laica</h1>
        <p>Perfil personal y bibliografía organizada con una presentación elegante y moderna.</p>
      </div>

      <div class="info-grid">
        <div class="info-card">
          <span class="label">Edad</span>
          <span class="value">20 años</span>
        </div>
        <div class="info-card">
          <span class="label">Ciudad</span>
          <span class="value">Salcedo</span>
        </div>
        <div class="info-card">
          <span class="label">Pasatiempo</span>
          <span class="value">Fútbol</span>
        </div>
        <div class="info-card">
          <span class="label">Carrera</span>
          <span class="value">Software</span>
        </div>
      </div>

      <div class="bibliography">
        <div class="bibliography-title">Bibliografía</div>
        <p>
          Tengo 20 años, soy de la ciudad de Salcedo. Me gusta jugar fútbol y ahora estoy
          estudiando una carrera de Ingeniería en Software.
        </p>
      </div>
    </section>
  </main>
</body>
</html>
